{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)",
      "Read(./**/*.pfx)",
      "Read(./**/*.p12)",
      "Read(./**/*.tfstate)",
      "Read(./**/*.tfvars)",
      "Read(./**/secrets/**)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push origin main:*)",
      "Bash(git push origin dev:*)",
      "Bash(git reset --hard:*)",
      "Bash(az role:*)",
      "Bash(az ad:*)",
      "Bash(az policy:*)",
      "Bash(az keyvault secret:*)",
      "Bash(terraform apply:*)",
      "Bash(terraform destroy:*)",
      "Bash(gh secret:*)",
      "Bash(gh repo delete:*)",
      "Bash(gh repo edit:*)"
    ],
    "ask": [
      "Bash(git push:*)",
      "Bash(az:*)",
      "Bash(terraform:*)",
      "Bash(gh api:*)",
      "Bash(npm install:*)",
      "Bash(bun add:*)",
      "Bash(curl:*)",
      "WebFetch"
    ]
  }
}
